{
  "name": "wiki-as-git-monorepo",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "pnpm -F wiki-as-git test",
    "build": "pnpm --filter core build && pnpm --filter sync build && pnpm --filter browser run build:demo",
    "build:demo": "pnpm -F browser run build:demo",
    "dev": "pnpm run build && netlify dev",
    "dev:browser": "node scripts/ensure-netlify-cjs.cjs && pnpm run build:demo && netlify dev --port 3000",
    "sync:local": "pnpm -F sync run run:local",
    "lint": "eslint .",
    "lint:all": "eslint . && pnpm -r lint"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=8"
  },
  "dependencies": {
    "sync": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/functions": "^5.1.3",
    "@types/node": "^22.4.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "netlify-cli": "^22.0.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
